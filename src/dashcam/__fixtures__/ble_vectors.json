  },
  "TIME_PING": {
   "type": 132,
   "dir": "rx",
   "len": 12,
   "fields": [["req_id", "u16"], ["epoch_ms", "u64"]]
  },
  "RESUME": {
   "type": 133,
   "dir": "rx",
   "len": 10,
   "fields": [["boot_id", "u32"], ["next_seq", "u32"]]
  },
  "COMMAND": {
   "type": 134,
   "dir": "rx",
   "len": 4,
   "fields": [["op", "u8"], ["arg", "u8"]]
  }
 },
