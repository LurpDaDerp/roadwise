# Public client identifiers only: every EXPO_PUBLIC_ value is built into the app, so nothing secret
# goes here. Copy this file to .env (never committed) and fill it in.

# --- Supabase: the only two values the app needs from the Supabase dashboard ---
# Both are in the dashboard's Connect button (top of the project page, "Mobile" tab, Expo React
# Native). The key is also under Project Settings > API Keys, "Publishable and secret API keys" tab.
# Use the publishable key (sb_publishable_...). Ignore the "Legacy anon, service_role API keys" tab
# and the legacy JWT secret: they are deprecated and nothing in RoadWise uses them. Never put a
# secret key (sb_secret_...) here; the edge functions get theirs from Supabase automatically.
# Locally, `npx supabase status` prints both (API_URL and PUBLISHABLE_KEY; local ports are 546xx).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Google Cloud Console (not Supabase) ---
# OAuth client ids, APIs & Services > Credentials: one Web, one iOS, one Android client.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
# Maps SDK for Android key, restricted to com.lurp.safedrive and the signing SHA-1.
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_KEY=

# --- Read by the Supabase CLI only (never by the app) ---
# `npx supabase config push` reads this for the production Google provider: the three Google client
# ids above joined with commas, web first.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
