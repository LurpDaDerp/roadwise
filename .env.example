# Copy this file to `.env` and fill in every value, then restart the bundler:
#   npx expo start --clear
#
# Everything here is a PUBLIC client identifier that ships inside the app binary.
# It is not a secret store. Real secrets (OpenAI, HERE) live in Cloud Functions secrets:
#   firebase functions:secrets:set OPENAI_API_KEY
#   firebase functions:secrets:set HERE_API_KEY
#
# For EAS builds these must also exist as EAS environment variables of the same name
# (EAS does not upload .env). See docs/BACKEND_AUDIT.md > Deploy steps.

# Firebase console > Project settings > Your apps > Web app > SDK setup and configuration
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Supabase dashboard > Project settings > API (project URL and the `anon` public key)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Google Cloud console > APIs & Services > Credentials > OAuth 2.0 Client IDs.
# Three separate client ids are required; see docs/BACKEND_AUDIT.md > Google sign-in.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
