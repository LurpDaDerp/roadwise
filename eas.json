{
  "cli": { "version": ">= 24.0.0", "appVersionSource": "remote" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": { "EXPO_PUBLIC_DIAGNOSTICS": "1" }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": { "EXPO_PUBLIC_DIAGNOSTICS": "1" }
    },
    "production": { "autoIncrement": true, "channel": "production" }
  },
  "submit": { "production": {} }
}
