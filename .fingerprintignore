# Continuous Native Generation: the root ios/ and android/ folders are generated by prebuild and
# never committed. EAS generates them before it fingerprints, so counting them would make the
# runtime version on EAS differ from the one calculated locally. Module native code
# (modules/*/ios, modules/*/android) is still fingerprinted.
ios
ios/**/*
android
android/**/*

# Gradle caches inside local Expo modules (machine-specific)
**/.gradle
**/.gradle/**/*
