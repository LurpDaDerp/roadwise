rules_version = '2';

// RoadCash Firestore security rules.
//
// Threat model
// ------------
// Anyone can create an account, so "signed in" is not an authorization decision. The two
// things that must never be readable by an arbitrary account are (a) a family's live
// location and emergency state and (b) a user's private data: their Expo push token, their
// trusted contacts' phone numbers, their email address, and WHICH GROUP THEY ARE IN.
//
// That last one matters because the group document id IS the join code. Leaving `groupId`
// on a publicly readable profile meant anyone could list users, read a group id, and then
// use the join rule below to add themselves to that family - the enumeration is the attack,
// not the join rule. `groupId` now lives in users/{uid}/private/info and may only be
// removed from the public profile, never written to it.
//
// Shape of the data this assumes
// ------------------------------
//   users/{uid}                        public profile (username, points, streak, photo)
//   users/{uid}/private/{doc}          owner only     (info incl. groupId, contacts, push, usage)
//   users/{uid}/drivemetrics/{id}      owner only
//   usernames/{lowercase}              uniqueness claim, existence is public
//   groups/{groupId}                   members only
//   apikeys/**, geocache/**            server only
//
// A note on `in`
// --------------
// `diff().affectedKeys()` returns a Set. The `in` operator is documented for List and Map,
// not Set, so every key test against affectedKeys() uses hasAny/hasAll/hasOnly, which are
// defined on both Set and List. A runtime evaluation error in a rule denies the request, so
// an undocumented operator here would have failed every users/* and groups/* update.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /* ---------------------------------------------------------------- *
     * Server-only collections
     * ---------------------------------------------------------------- */

    // API keys are Cloud Functions secrets; nothing client-side may touch this.
    match /apikeys/{document=**} {
      allow read, write: if false;
    }

    // Shared reverse-geocode / speed-limit cache written by Cloud Functions only.
    match /geocache/{cell} {
      allow read, write: if false;
    }

    /* ---------------------------------------------------------------- *
     * Username claims
     *
     * `get` is public because sign-up has to check a name before an account exists, and
     * the only fact it exposes is whether a username is taken - which any sign-up form
     * reveals anyway. Listing is denied so the registry cannot be enumerated.
     * ---------------------------------------------------------------- */

    match /usernames/{name} {
      function claim() { return request.resource.data; }

      allow get: if true;
      allow list: if false;

      allow create: if isSignedIn()
        && claim().keys().hasOnly(['uid', 'username', 'createdAt'])
        && claim().uid == request.auth.uid
        && claim().username is string
        && claim().username.size() > 0
        && claim().username.size() <= 16
        && claim().username.lower() == name;

      allow update: if isSignedIn()
        && resource.data.uid == request.auth.uid
        && claim().keys().hasOnly(['uid', 'username', 'createdAt'])
        && claim().uid == request.auth.uid
        && claim().username is string
        && claim().username.size() <= 16
        && claim().username.lower() == name;

      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    /* ---------------------------------------------------------------- *
     * Users
     * ---------------------------------------------------------------- */

    match /users/{userId} {
      function incoming() { return request.resource.data; }
      function changedKeys() { return request.resource.data.diff(resource.data).affectedKeys(); }

      // The complete public surface. Everything the leaderboard and the group member list
      // need, and nothing else.
      function profileKeys() {
        return [
          'username', 'usernameLower', 'points', 'drivingStreak', 'totalDrives',
          'photoURL', 'isDriving', 'createdAt', 'lastDriveAt'
        ];
      }

      // These lived here and should not have. They may still be DELETED (that is what the
      // migration does), but never written again.
      //   pushToken       - a bearer credential for pushing to that device
      //   trustedContacts - third parties' names and phone numbers
      //   groupId         - the group join code; see the header note
      function legacyKeys() { return ['pushToken', 'trustedContacts', 'groupId']; }

      // `request.resource.data` is the WHOLE resulting document, not the delta, so these
      // checks are scoped to the keys a write actually touches. Checking the whole
      // document instead would permanently lock out any account that still carries a
      // legacy or unrecognised field.
      function legacyOnlyRemoved(touched) {
        return (!touched.hasAny(['pushToken']) || !('pushToken' in incoming()))
          && (!touched.hasAny(['trustedContacts']) || !('trustedContacts' in incoming()))
          && (!touched.hasAny(['groupId']) || !('groupId' in incoming()));
      }

      function validTypes(touched) {
        return (!touched.hasAny(['username'])
                || (incoming().username is string && incoming().username.size() <= 16))
          && (!touched.hasAny(['usernameLower']) || incoming().usernameLower is string)
          && (!touched.hasAny(['points'])
                || (incoming().points is number && incoming().points >= 0))
          && (!touched.hasAny(['drivingStreak'])
                || (incoming().drivingStreak is number && incoming().drivingStreak >= 0))
          && (!touched.hasAny(['totalDrives'])
                || (incoming().totalDrives is number && incoming().totalDrives >= 0))
          && (!touched.hasAny(['isDriving']) || incoming().isDriving is bool)
          && (!touched.hasAny(['photoURL'])
                || incoming().photoURL == null || incoming().photoURL is string);
      }

      // Points may only go up, and by no more than one very long drive's worth per write.
      // Points accrue at roughly one per 2.5 s, so 20,000 is about fourteen hours of
      // driving - unreachable in practice, while still bounding a single forged write.
      // The same ceiling is used on the drive record so the two halves of the atomic
      // finalization batch can never disagree and take the whole batch down with them.
      // This is a speed bump, not an anti-cheat system: awarding points from a Cloud
      // Function is the only way to make them authoritative (see docs/BACKEND_AUDIT.md).
      function pointsMovementOk() {
        return !changedKeys().hasAny(['points'])
          || (incoming().points >= resource.data.get('points', 0)
              && incoming().points <= resource.data.get('points', 0) + 20000);
      }

      // The leaderboard reads every user's username and points; the group map reads other
      // members' username and photo. Both are list/get on this document.
      allow get: if isSignedIn();
      allow list: if isSignedIn();

      allow create: if isSelf(userId)
        && incoming().keys().hasOnly(profileKeys())
        && validTypes(incoming().keys())
        && (!('points' in incoming()) || incoming().points <= 20000);

      allow update: if isSelf(userId)
        && changedKeys().hasOnly(profileKeys().concat(legacyKeys()))
        && legacyOnlyRemoved(changedKeys())
        && validTypes(changedKeys())
        && pointsMovementOk();

      allow delete: if false;

      // groupId, email, trusted contacts, push token, per-day API usage counters.
      match /private/{docId} {
        allow read, write: if isSelf(userId);
      }

      match /drivemetrics/{driveId} {
        function drive() { return request.resource.data; }

        function validDrive() {
          return drive().keys().size() <= 30
            && drive().timestamp == request.time
            && (!('points' in drive())
                  || (drive().points is number && drive().points >= 0 && drive().points <= 20000))
            && (!('duration' in drive())
                  || (drive().duration is number && drive().duration >= 0))
            && (!('distracted' in drive())
                  || drive().distracted is number || drive().distracted is bool)
            && (!('totalDistance' in drive()) || drive().totalDistance is number);
        }

        allow read: if isSelf(userId);
        allow create: if isSelf(userId) && validDrive();
        allow update: if false;
        allow delete: if isSelf(userId);
      }
    }

    /* ---------------------------------------------------------------- *
     * Groups
     *
     * A group is readable only by its members. Membership is the `members` array;
     * groups created before that field existed fall back to the keys of memberLocations
     * so existing families are not locked out.
     *
     * Joining is the one write a non-member may make: adding exactly themselves. That is
     * only safe because the join code is not discoverable - see the header note about
     * groupId. The client does not read the group first (it cannot), so an invalid code
     * surfaces as not-found or permission-denied.
     * ---------------------------------------------------------------- */

    match /groups/{groupId} {
      function incoming() { return request.resource.data; }
      function currentMembers() { return resource.data.get('members', []); }
      function currentLocations() { return resource.data.get('memberLocations', {}); }

      function isMember() {
        return isSignedIn()
          && (request.auth.uid in currentMembers()
              || request.auth.uid in currentLocations().keys());
      }

      function changedKeys() {
        return request.resource.data.diff(resource.data).affectedKeys();
      }

      function touchesOnlyOwnLocation() {
        return !changedKeys().hasAny(['memberLocations'])
          || incoming().memberLocations.diff(currentLocations())
               .affectedKeys().hasOnly([request.auth.uid]);
      }

      function ownLocationValid() {
        return !changedKeys().hasAny(['memberLocations'])
          || !(request.auth.uid in incoming().memberLocations)
          || (
            incoming().memberLocations[request.auth.uid].keys()
              .hasOnly(['latitude', 'longitude', 'speed', 'updatedAt', 'emergency'])
            && (incoming().memberLocations[request.auth.uid].get('latitude', null) == null
                || (incoming().memberLocations[request.auth.uid].latitude is number
                    && incoming().memberLocations[request.auth.uid].latitude >= -90
                    && incoming().memberLocations[request.auth.uid].latitude <= 90))
            && (incoming().memberLocations[request.auth.uid].get('longitude', null) == null
                || (incoming().memberLocations[request.auth.uid].longitude is number
                    && incoming().memberLocations[request.auth.uid].longitude >= -180
                    && incoming().memberLocations[request.auth.uid].longitude <= 180))
            && (!('emergency' in incoming().memberLocations[request.auth.uid])
                || incoming().memberLocations[request.auth.uid].emergency is bool)
          );
      }

      function membersUnchanged() {
        return !changedKeys().hasAny(['members']);
      }

      function membersOnlyAddsSelf() {
        return changedKeys().hasAny(['members'])
          && incoming().members.hasAll(currentMembers())
          && incoming().members.hasOnly(currentMembers().concat([request.auth.uid]))
          && request.auth.uid in incoming().members;
      }

      function membersOnlyRemovesSelf() {
        return changedKeys().hasAny(['members'])
          && currentMembers().hasAll(incoming().members)
          && !(request.auth.uid in incoming().members);
      }

      function savedLocationsValid() {
        return !changedKeys().hasAny(['savedLocations'])
          || (incoming().savedLocations is list && incoming().savedLocations.size() <= 100);
      }

      allow get: if isMember();
      allow list: if false;

      allow create: if isSignedIn()
        && incoming().keys().hasOnly(
             ['groupName', 'createdBy', 'createdAt', 'members', 'memberLocations', 'savedLocations'])
        && incoming().createdBy == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().members == [request.auth.uid]
        && incoming().memberLocations.keys().hasOnly([request.auth.uid])
        && incoming().savedLocations.size() == 0
        && incoming().groupName is string
        && incoming().groupName.size() > 0
        && incoming().groupName.size() <= 40;

      allow update: if isSignedIn()
        // Immutable once created: name, owner, creation time.
        && changedKeys().hasOnly(['members', 'memberLocations', 'savedLocations'])
        && touchesOnlyOwnLocation()
        && ownLocationValid()
        && savedLocationsValid()
        && (
          // A member updating their own position, the shared places, or leaving.
          (isMember() && (membersUnchanged() || membersOnlyRemovesSelf()))
          // Someone joining with a valid code: adds only themselves, nothing else.
          || (membersOnlyAddsSelf() && !changedKeys().hasAny(['savedLocations']))
        );

      allow delete: if false;
    }

    /* ---------------------------------------------------------------- *
     * Everything else is denied.
     * ---------------------------------------------------------------- */

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
