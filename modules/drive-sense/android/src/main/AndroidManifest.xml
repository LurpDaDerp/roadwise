<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <!-- Location: 1 Hz GNSS while a watch or a drive runs, in the location foreground service. The
       Start card needs While Using; automatic drives need "Allow all the time" (Android 10+): the
       drive detector's wakes (an activity transition, the parked geofence's exit) start its
       location service from the background, and the parked geofence needs it. Asked for only
       through DriveDetect.requestAlways, after RoadWise's own explanation. -->
  <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
  <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
  <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
  <!-- Activity recognition (the detector's transitions and live reports, the walking end): the runtime permission on API 29+, the Play services one below it. -->
  <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
  <uses-permission android:name="com.google.android.gms.permission.ACTIVITY_RECOGNITION" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
  <!-- The DashPal link service (connectedDevice) while a DashPal is paired: the phone answers and
       plays the dashcam's alerts with RoadWise in the background. -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <!-- Android 16 QPR1+: the drive notification may be promoted to a Live Update (the lock screen's
       top and a status-bar chip with the speed), Android's Live Activity. A normal permission:
       granted at install; the driver can turn Live updates off in the app's notification settings,
       and the notification then wears the app's sky instead (NotificationFactory, LiveUpdates). -->
  <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
  <!-- HeadlessJsTaskService and the 1 Hz row timer hold a partial wake lock while a drive records (rev1: I15). -->
  <uses-permission android:name="android.permission.WAKE_LOCK" />
  <!-- The drive detector sets its wakes again after a reboot (DetectBootReceiver, enabled only while
       automatic drives are armed). -->
  <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
  <!-- The car link (CarLink.kt): a paired car's Bluetooth connecting wakes the drive detector
       (CarConnectReceiver: Android sends ACL_CONNECTED only to an app holding Bluetooth), and on
       Android 14+ a car's full Bluetooth address is readable only with Nearby devices
       (BLUETOOTH_CONNECT, Android 12+), asked for before "Use this car". DashPal's BLE (react-native-ble-manager)
       uses these too; its scan permissions come from plugins/withAndroidBluetoothScan.js. The car
       link never scans. -->
  <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
  <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

  <!-- The navigation button (README §2): the navigation apps RoadWise may find and open, by package
       (API 30+ package visibility). Exactly the Android packages of src/features/navigation/catalog.ts;
       never QUERY_ALL_PACKAGES. -->
  <queries>
    <package android:name="com.google.android.apps.maps" />
    <package android:name="com.waze" />
    <package android:name="com.google.android.apps.navlite" />
    <package android:name="com.here.app.maps" />
    <package android:name="com.sygic.aura" />
    <package android:name="com.tomtom.gplay.navapp" />
    <package android:name="com.generalmagic.magicearth" />
    <package android:name="net.osmand.plus" />
    <package android:name="net.osmand" />
    <package android:name="app.organicmaps" />
    <package android:name="com.mapquest.android.ace" />
    <package android:name="ru.yandex.yandexnavi" />
    <!-- The car link: Android Auto's connection provider (androidx.car.app's CarConnection
         contract), asked whether it projects to a car. -->
    <provider android:authorities="androidx.car.app.connection" />
  </queries>

  <application>
    <service
        android:name=".CaptureService"
        android:exported="false"
        android:foregroundServiceType="location" />

    <service
        android:name=".DriveSenseHeadlessService"
        android:exported="false" />

    <!-- Started only from JS with RoadWise visible (DashpalLinkService.set); never sticky. -->
    <service
        android:name=".DashpalLinkService"
        android:exported="false"
        android:foregroundServiceType="connectedDevice" />

    <!-- Play services' activity transitions and live reports, reached only through the explicit
         mutable PendingIntents handed to it. A confident in-a-vehicle transition is a drive
         detector wake (its broadcast may start the location service from the background). -->
    <receiver
        android:name=".ActivityTransitionReceiver"
        android:exported="false" />

    <!-- The parked car's geofence exit, reached only through the explicit mutable PendingIntent
         handed to Play services: a drive detector wake. -->
    <receiver
        android:name=".GeofenceReceiver"
        android:exported="false" />

    <!-- Disabled until automatic drives are armed (the detector enables it with DONT_KILL_APP).
         System broadcasts reach an unexported receiver. It only sets the wakes again. -->
    <receiver
        android:name=".DetectBootReceiver"
        android:exported="false"
        android:enabled="false">
      <intent-filter>
        <action android:name="android.intent.action.BOOT_COMPLETED" />
        <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
      </intent-filter>
    </receiver>

    <!-- A paired car's Bluetooth connecting: a drive detector wake (ruling 2). Disabled until
         automatic drives run with a car paired (the detector enables it with DONT_KILL_APP).
         Exported: the Bluetooth stack sends ACL_CONNECTED, a protected broadcast no app can fake. -->
    <receiver
        android:name=".CarConnectReceiver"
        android:exported="true"
        android:enabled="false">
      <intent-filter>
        <action android:name="android.bluetooth.device.action.ACL_CONNECTED" />
      </intent-filter>
    </receiver>

    <!-- Share images (ShareIntent.kt, WP09): a share card goes to the share sheet as a content URI
         from the cache directory only, with a read grant for the app picked. Never exported. -->
    <provider
        android:name=".ShareFileProvider"
        android:authorities="${applicationId}.drivesense.share"
        android:exported="false"
        android:grantUriPermissions="true">
      <meta-data
          android:name="android.support.FILE_PROVIDER_PATHS"
          android:resource="@xml/drivesense_share_paths" />
    </provider>

    <!-- The share sheet's Save image (Android 10+, MediaStore, no permission): the chooser action's
         receiver on 14+, reached only through RoadWise's explicit immutable PendingIntent... -->
    <receiver
        android:name=".SaveImageReceiver"
        android:exported="false" />

    <!-- ...and the sheet's first row on 10 to 13, which the chooser starts as RoadWise. Translucent
         and finished at once. -->
    <activity
        android:name=".SaveImageActivity"
        android:exported="false"
        android:noHistory="true"
        android:theme="@android:style/Theme.Translucent.NoTitleBar" />
  </application>

</manifest>
