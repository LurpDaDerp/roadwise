<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <!-- Location: 1 Hz GNSS while capturing. While Using only (plan §1 decision 4): a drive starts in
       the foreground, and the location foreground service keeps it running from there. No
       background-location permission anywhere. -->
  <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
  <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
  <!-- Activity transitions (walking auto-end during a drive): the runtime permission on API 29+, the Play services one below it. -->
  <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
  <uses-permission android:name="com.google.android.gms.permission.ACTIVITY_RECOGNITION" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <!-- HeadlessJsTaskService and the 1 Hz row timer hold a partial wake lock while a drive records (rev1: I15). -->
  <uses-permission android:name="android.permission.WAKE_LOCK" />

  <application>
    <service
        android:name=".CaptureService"
        android:exported="false"
        android:foregroundServiceType="location" />

    <service
        android:name=".DriveSenseHeadlessService"
        android:exported="false" />

    <!-- Reached only through the explicit PendingIntent handed to Play services. Never starts a capture. -->
    <receiver
        android:name=".ActivityTransitionReceiver"
        android:exported="false" />
  </application>

</manifest>
