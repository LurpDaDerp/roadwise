<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <!-- Location: 1 Hz GNSS while capturing. While Using only (plan §1 decision 4): a drive starts in
       the foreground, and the location foreground service keeps it running from there. No
       background-location permission anywhere. -->
  <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
  <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
  <!-- Activity transitions (walking auto-end during a drive): the runtime permission on API 29+, the Play services one below it. -->
  <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
  <uses-permission android:name="com.google.android.gms.permission.ACTIVITY_RECOGNITION" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
  <!-- The DashPal link service (connectedDevice) while a DashPal is paired: the phone answers and
       plays the dashcam's alerts with RoadWise in the background. -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <!-- HeadlessJsTaskService and the 1 Hz row timer hold a partial wake lock while a drive records (rev1: I15). -->
  <uses-permission android:name="android.permission.WAKE_LOCK" />
  <!-- The forgot-to-start reminder re-registers its activity feed after a reboot (ReminderBootReceiver,
       enabled only while the reminder is on). It starts nothing. -->
  <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

  <!-- The navigation button (README §2): the navigation apps RoadWise may find and open, by package
       (API 30+ package visibility). Exactly the Android packages of src/features/navigation/catalog.ts;
       never QUERY_ALL_PACKAGES. -->
  <queries>
    <package android:name="com.google.android.apps.maps" />
    <package android:name="com.waze" />
    <package android:name="com.google.android.apps.navlite" />
    <package android:name="com.here.app.maps" />
    <package android:name="com.sygic.aura" />
    <package android:name="com.tomtom.gplay.navapp" />
    <package android:name="com.generalmagic.magicearth" />
    <package android:name="net.osmand.plus" />
    <package android:name="net.osmand" />
    <package android:name="app.organicmaps" />
    <package android:name="com.mapquest.android.ace" />
    <package android:name="ru.yandex.yandexnavi" />
  </queries>

  <application>
    <service
        android:name=".CaptureService"
        android:exported="false"
        android:foregroundServiceType="location" />

    <service
        android:name=".DriveSenseHeadlessService"
        android:exported="false" />

    <!-- Started only from JS with RoadWise visible (DashpalLinkService.set); never sticky. -->
    <service
        android:name=".DashpalLinkService"
        android:exported="false"
        android:foregroundServiceType="connectedDevice" />

    <!-- Reached only through the explicit PendingIntent handed to Play services. Never starts a capture. -->
    <receiver
        android:name=".ActivityTransitionReceiver"
        android:exported="false" />

    <!-- Disabled until the forgot-to-start reminder is turned on (TripReminder enables it with
         DONT_KILL_APP). System broadcasts reach an unexported receiver. It only re-subscribes. -->
    <receiver
        android:name=".ReminderBootReceiver"
        android:exported="false"
        android:enabled="false">
      <intent-filter>
        <action android:name="android.intent.action.BOOT_COMPLETED" />
        <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
      </intent-filter>
    </receiver>
  </application>

</manifest>
