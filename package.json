    "expo-updates": "~57.0.23",
    "expo-web-browser": "~57.0.3",
    "fflate": "0.8.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-ble-manager": "12.5.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-get-random-values": "~1.11.0",
