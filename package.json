    "@testing-library/react-native": "^14.0.1",
    "@types/aes-js": "^3.1.4",
    "@types/jest": "29.5.14",
    "@types/node": "26.6.2",
    "@types/react": "~19.2.2",
    "@types/sql.js": "1.4.11",
    "babel-preset-expo": "~57.0.0",
    "eslint": "^9.39.5",
