{
  "name": "roadwise",
  "version": "2.0.0",
  "main": "index.ts",
  "private": true,
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "test": "jest",
    "e2e:dashpal": "jest -c jest.e2e.config.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc -p scripts --noEmit && tsc -p packages/scoring",
    "typecheck:scoring": "tsc -p packages/scoring",
    "scoring:sync": "node scripts/sync-scoring.js",
    "tones:make": "node scripts/make-tones.js",
    "traces:make": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/make-traces.js",
    "db:start": "supabase start",
    "db:test": "supabase db reset && supabase test db",
    "db:types": "supabase gen types typescript --local > src/data/supabase/types.ts",
    "functions:check": "deno lint --config supabase/functions/deno.json supabase/functions && deno check --config supabase/functions/deno.json supabase/functions",
    "functions:test": "deno test --config supabase/functions/deno.json supabase/functions"
  },
  "dependencies": {
    "@expo-google-fonts/b612": "^0.4.1",
    "@expo-google-fonts/b612-mono": "^0.4.1",
