# dependencies
node_modules/

# expo / native (CNG: generated, never committed)
# Anchored: unanchored `ios/` / `android/` also swallow every local Expo module's own native
# sources (modules/*/ios, modules/*/android), which are hand-written and must be committed.
.expo/
/ios/
/android/
*.orig.*
web-build/
dist/
expo-env.d.ts

# eas
*.ipa
*.apk
*.aab
.eas-build-local/

# env
.env
.env.*
!.env.example

# Firebase (FCM) Android credential (Task 18): never committed. EAS builds read the
# GOOGLE_SERVICES_JSON file variable. Deliberately NOT in .easignore: a local copy may be uploaded
# to an EAS build, which is where it is meant to go.
google-services.json

# supabase local
supabase/.temp/
supabase/.branches/
supabase/data/downloads/

# agent and design-tool artifacts (never committed)
.agent/
.impeccable/
.claude/
CLAUDE.md
.superpowers/
PRODUCT.md
DESIGN.md
/product spec v3.md
docs/

# os / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# logs
npm-debug.log*
*.log

# user-provided DMS design spec (local reference, never committed or uploaded)
/Driver Monitoring System (DMS) Design Spec.md

# Gradle caches inside local Expo modules (machine-specific)
.gradle/
