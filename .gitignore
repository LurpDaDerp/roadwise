# dependencies
node_modules/

# expo / native (CNG: generated, never committed)
# Anchored: unanchored `ios/` / `android/` also swallow every local Expo module's own native
# sources (modules/*/ios, modules/*/android), which are hand-written and must be committed.
.expo/
/ios/
/android/
*.orig.*
web-build/
dist/
expo-env.d.ts

# eas
*.ipa
*.apk
*.aab
.eas-build-local/

# env
.env
.env.*
!.env.example

# Firebase (FCM) Android credential (Task 18): never committed. EAS builds read the
# GOOGLE_SERVICES_JSON file variable. Deliberately NOT in .easignore: a local copy may be uploaded
# to an EAS build, which is where it is meant to go.
google-services.json

# supabase local
supabase/.temp/
supabase/.branches/
supabase/data/downloads/

# agent and design-tool artifacts (never committed)
.agent/
.agents/
.impeccable/
.claude/
CLAUDE.md
.superpowers/
PRODUCT.md
product spec v3.md
DESIGN.md
/product spec v3.md
docs/
skills-lock.json

# os / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# logs
npm-debug.log*
*.log

# user-provided DMS design spec (local reference, never committed or uploaded)
/Driver Monitoring System (DMS) Design Spec.md

# Gradle caches and build output inside local Expo modules (machine-specific, written by every
# Android compile of modules/*/android)
.gradle/
modules/*/android/build/
modules/*/android/.gradle/

# The Google Play service account key `eas submit` uses (GOOGLE_PLAY_SERVICE_ACCOUNT_KEY_PATH):
# kept outside the repo; never committed or uploaded if one lands here by mistake.
google-play-service-account*.json
*-service-account*.json

# Privacy Policy, Terms and the data audit: local drafts, never committed (the app carries its
# own copy in src/features/legal/documents.ts, written by `npm run legal:sync`)
/legal/

# getroadwise.app build output (npm run site:build); .vercel/ inside it links the Vercel project
/web/site-dist/
