# eas-cli reads this file INSTEAD of .gitignore when it packs the project for a build, so it must
# mirror every .gitignore exclusion. Keep the two in sync; anything dropped here gets uploaded.

# dependencies
node_modules/

# expo / native (CNG: generated, never committed)
# Anchored: unanchored `ios/` / `android/` also swallow every local Expo module's own native
# sources (modules/*/ios, modules/*/android), which are hand-written and must be committed.
.expo/
/ios/
/android/
*.orig.*
web-build/
dist/
expo-env.d.ts

# eas
*.ipa
*.apk
*.aab
.eas-build-local/

# env
.env
.env.*
!.env.example

# supabase local
supabase/.temp/
supabase/.branches/
supabase/data/downloads/

# agent and design-tool artifacts (never committed)
.agent/
.impeccable/
.claude/
.superpowers/
PRODUCT.md
DESIGN.md
docs/

# os / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# logs
npm-debug.log*
*.log

# user-provided DMS design spec (local reference, never committed or uploaded)
/Driver Monitoring System (DMS) Design Spec.md
