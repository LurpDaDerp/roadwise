# eas-cli reads this file INSTEAD of .gitignore when it packs the project for a build, so it must
# mirror every .gitignore exclusion. Keep the two in sync; anything dropped here gets uploaded.

# dependencies
node_modules/

# expo / native (CNG: generated, never committed)
# Anchored: unanchored `ios/` / `android/` also swallow every local Expo module's own native
# sources (modules/*/ios, modules/*/android), which are hand-written and must be committed.
.expo/
/ios/
/android/
*.orig.*
web-build/
dist/
expo-env.d.ts

# eas
*.ipa
*.apk
*.aab
.eas-build-local/

# env
.env
.env.*
!.env.example

# supabase local
supabase/.temp/
supabase/.branches/
supabase/data/downloads/

# agent and design-tool artifacts (never committed)
.agent/
.agents/
.impeccable/
.claude/
CLAUDE.md
.superpowers/
PRODUCT.md
product spec v3.md
DESIGN.md
docs/
skills-lock.json

# os / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# logs
npm-debug.log*
*.log

# user-provided DMS design spec (local reference, never committed or uploaded)
/Driver Monitoring System (DMS) Design Spec.md

# Gradle caches and build output inside local Expo modules (machine-specific, written by every
# Android compile of modules/*/android)
.gradle/
modules/*/android/build/
modules/*/android/.gradle/

# The Google Play service account key `eas submit` uses (GOOGLE_PLAY_SERVICE_ACCOUNT_KEY_PATH):
# kept outside the repo; never committed or uploaded if one lands here by mistake.
google-play-service-account*.json
*-service-account*.json

# Privacy Policy, Terms and the data audit drafts (the app bundles src/features/legal/documents.ts)
/legal/

# getroadwise.app build output (npm run site:build): the app never reads it
/web/site-dist/

# Local release notes (the App Store checklist holds the App Review demo account): never uploaded
IOS_DISTRIBUTION_CHECKLIST.md
FUTURE_TODO.md
