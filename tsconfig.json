{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "types": ["jest"],
    "paths": { "@/*": ["./src/*"], "@scoring": ["./packages/scoring/src/index.ts"] }
