{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "types": ["jest"],
    "paths": {
      "@/*": ["./src/*"],
      "@scoring": ["./packages/scoring/src/index.ts"],
      "@scoring/*": ["./packages/scoring/src/*"],
      "@drive-sense": ["./modules/drive-sense/index.ts"],
      "@drive-sense/*": ["./modules/drive-sense/src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
  "exclude": ["node_modules", "scripts", "supabase/functions"]
}
